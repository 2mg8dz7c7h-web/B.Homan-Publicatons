<section class="page-width feature"><div class="feature-visual" aria-hidden="true"><div class="feature-stamp">A regional<br>point of view</div></div><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="section-heading">{{ section.settings.heading | escape | newline_to_br }}</h2><div class="lead">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<p><a class="text-link" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }} →</a></p>{% endif %}</div></section>
{% schema %}{"name":"Point of view","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our point of view"},{"type":"textarea","id":"heading","label":"Heading","default":"Good publishing begins with curiosity."},{"type":"richtext","id":"text","label":"Text","default":"<p>We value a thoughtful question, a well-told story and an informed perspective. Our work is guided by editorial care, an interest in enterprise and a belief that regional stories deserve serious attention.</p><p>We aim to make publications people choose to spend time with — useful, distinctive and made to last.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Our publishing principles"},{"type":"url","id":"button_link","label":"Button link"}]}{% endschema %}