<div class="page-width collection-layout"><p class="eyebrow">Journal</p><h1 class="section-heading">{{ blog.title | escape }}</h1>{% paginate blog.articles by 9 %}<div class="collection-products">{% for article in blog.articles %}<article class="product-card"><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.image.alt }}{% endif %}<h3>{{ article.title | escape }}</h3></a><span class="small-copy">{{ article.published_at | date: '%d %B %Y' }}</span><p>{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p></article>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div>{% schema %}{"name":"Main blog","settings":[]}{% endschema %}