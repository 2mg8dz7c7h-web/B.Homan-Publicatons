<section class="publications" id="publications"><div class="page-width"><div class="section-top"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="section-heading">{{ section.settings.heading | escape }}</h2></div><p>{{ section.settings.description | escape }}</p></div><div class="publication-grid">{% for block in section.blocks %}<article class="publication-card" {{ block.shopify_attributes }}><div class="publication-number">{{ forloop.index | prepend: '0' }} / {{ block.settings.category | escape }}</div><div class="publication-cover"><div class="cover-sheet"><small>{{ block.settings.cover_kicker | escape }}</small><strong>{{ block.settings.title | escape }}</strong><i></i><small>Independent · Australia</small></div></div><h3 class="publication-title">{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p>{% if block.settings.link_label != blank %}<a class="text-link" href="{{ block.settings.link | default: routes.root_url }}">{{ block.settings.link_label | escape }} →</a>{% endif %}</article>{% endfor %}</div></div></section>
{% schema %}{"name":"Publication portfolio","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our portfolio"},{"type":"text","id":"heading","label":"Heading","default":"A house of considered titles."},{"type":"textarea","id":"description","label":"Description","default":"A developing collection of editorial titles, each with its own subject, voice and readership."}],"blocks":[{"type":"publication","name":"Publication","settings":[{"type":"text","id":"title","label":"Title","default":"The Regional Review"},{"type":"text","id":"category","label":"Category","default":"Regional affairs"},{"type":"text","id":"cover_kicker","label":"Cover kicker","default":"The independent journal"},{"type":"textarea","id":"description","label":"Description","default":"People, places, ideas and the issues shaping regional Australia."},{"type":"text","id":"link_label","label":"Link label","default":"Explore publication"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Publication portfolio","blocks":[{"type":"publication","settings":{"title":"The Regional Review","category":"Regional affairs","cover_kicker":"Regional perspective","description":"People, places, ideas and the issues shaping regional Australia."}},{"type":"publication","settings":{"title":"The Business Review","category":"Enterprise","cover_kicker":"Business & enterprise","description":"Business, investment, agriculture and the regional economy."}},{"type":"publication","settings":{"title":"The Country Journal","category":"Culture & lifestyle","cover_kicker":"Country life","description":"Hospitality, culture, travel and the character of country living."}},{"type":"publication","settings":{"title":"The Property Review","category":"Property","cover_kicker":"Property & place","description":"Rural, residential and commercial property, considered."}},{"type":"publication","settings":{"title":"The Regional Exchange","category":"Directory","cover_kicker":"The regional network","description":"A future home for businesses, services and useful connections."}},{"type":"publication","settings":{"title":"The Review Society","category":"Events","cover_kicker":"Ideas in company","description":"A future programme of gatherings, conversations and experiences."}}]}]}{% endschema %}