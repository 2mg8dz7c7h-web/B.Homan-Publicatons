<section class="hero{% if section.settings.image != blank %} has-image{% endif %}"{% if section.settings.image != blank %} style="background-image:url('{{ section.settings.image | image_url: width: 2400 }}')"{% endif %}>
{% if section.settings.image == blank %}<div class="hero-art" aria-hidden="true"></div>{% endif %}
<div class="page-width"><div class="hero-content"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 class="display">{{ section.settings.heading | escape | newline_to_br }}</h1><div class="lead">{{ section.settings.text }}</div>
<div class="hero-actions">{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }} ↗</a>{% endif %}{% if section.settings.secondary_label != blank %}<a class="text-link" href="{{ section.settings.secondary_link | default: '#about' }}">{{ section.settings.secondary_label | escape }} →</a>{% endif %}</div></div></div>
{% if section.settings.note != blank %}<div class="hero-note">{{ section.settings.note | escape }}</div>{% endif %}</section>
{% schema %}{"name":"Editorial hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"An independent Australian publishing house"},{"type":"textarea","id":"heading","label":"Heading","default":"Stories that shape our regions."},{"type":"richtext","id":"text","label":"Text","default":"<p>Independent perspectives on the people, places, enterprise and ideas shaping regional Australia.</p>"},{"type":"text","id":"button_label","label":"Primary button","default":"Discover our publications"},{"type":"url","id":"button_link","label":"Primary button link"},{"type":"text","id":"secondary_label","label":"Secondary link","default":"Our approach"},{"type":"url","id":"secondary_link","label":"Secondary link URL"},{"type":"text","id":"note","label":"Small note","default":"Independent by nature. Regional by perspective."},{"type":"image_picker","id":"image","label":"Optional hero image"}]}{% endschema %}