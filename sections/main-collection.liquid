<div class="page-width collection-layout"><p class="eyebrow">The collection</p><h1 class="section-heading">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}{% paginate collection.products by 12 %}<div class="collection-products">{% for product in collection.products %}<article class="product-card"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.featured_image.alt }}{% endif %}<h3>{{ product.title | escape }}</h3></a><span>{{ product.price | money }}</span></article>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div>{% schema %}{"name":"Main collection","settings":[]}{% endschema %}