<div class="page-width cart-page"><p class="eyebrow">Your selection</p><h1 class="section-heading">Shopping bag</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" novalidate>{% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: alt: item.image.alt }}{% endif %}</a><div><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a><p class="small-copy">{{ item.variant.title }}</p><label class="small-copy" for="updates_{{ item.key }}">Quantity</label><input class="quantity" id="updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><div>{{ item.final_line_price | money }}</div></div>{% endfor %}<p style="text-align:right">Subtotal: <strong>{{ cart.total_price | money }}</strong></p><div style="display:flex;justify-content:flex-end;gap:15px;flex-wrap:wrap"><button class="button button--outline" type="submit" name="update">Update bag</button><button class="button" type="submit" name="checkout">Checkout ↗</button></div></form>{% else %}<div class="empty-state"><p>Your bag is currently empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore publications</a></div>{% endif %}</div>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}