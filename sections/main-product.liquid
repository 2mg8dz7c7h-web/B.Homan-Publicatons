<div class="page-width product-layout"><div class="product-grid"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: product.featured_image.alt }}{% endif %}</div><div class="product-info"><p class="eyebrow">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1><div class="price">{{ product.selected_or_first_available_variant.price | money }}</div><div class="rte">{{ product.description }}</div>{% form 'product', product, class: 'product-form' %}{% if product.variants.size > 1 %}<label for="VariantSelect">Format</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} – {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}<label for="Quantity">Quantity</label><input class="quantity" id="Quantity" type="number" name="quantity" value="1" min="1"><button class="button" type="submit" name="add"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>{{ form | payment_button }}</form></div></div></div>{% schema %}{"name":"Main product","settings":[]}{% endschema %}