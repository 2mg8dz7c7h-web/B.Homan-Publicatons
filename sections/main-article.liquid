<article><header class="page-width article-header"><p class="article-meta">{{ article.published_at | date: '%d %B %Y' }}{% if article.author != blank %} · {{ article.author | escape }}{% endif %}</p><h1 class="article-title">{{ article.title | escape }}</h1>{% if article.excerpt != blank %}<p class="lead">{{ article.excerpt | strip_html }}</p>{% endif %}</header>{% if article.image %}<div class="page-width">{{ article.image | image_url: width: 1800 | image_tag: loading: 'eager', alt: article.image.alt }}</div>{% endif %}<div class="page-width article-body rte">{{ article.content }}</div></article>{% schema %}{"name":"Main article","settings":[]}{% endschema %}