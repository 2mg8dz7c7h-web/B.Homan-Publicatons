<section class="page-width contact" id="contact"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="section-heading">{{ section.settings.heading | escape }}</h2><div class="lead">{{ section.settings.text }}</div></div><div>{% form 'contact', id: 'BHPublicationsContact' %}{% if form.posted_successfully? %}<p class="form-status">Thank you for getting in touch. Your enquiry has been received.</p>{% endif %}{{ form.errors | default_errors }}<div class="contact-form"><div class="field"><label for="ContactName">Name</label><input id="ContactName" type="text" name="contact[name]" autocomplete="name" required></div><div class="field"><label for="ContactEmail">Email address</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required></div><div class="field field--full"><label for="ContactSubject">Enquiry type</label><select id="ContactSubject" name="contact[Enquiry type]"><option>General enquiry</option><option>Advertising and partnerships</option><option>Editorial submission</option><option>Business enquiry</option></select></div><div class="field field--full"><label for="ContactMessage">Message</label><textarea id="ContactMessage" name="contact[body]" required></textarea></div><div class="field--full"><button class="button" type="submit">{{ section.settings.button_label | escape }} ↗</button></div></div>{% endform %}</div></section>
{% schema %}{"name":"Contact enquiry","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Start a conversation"},{"type":"text","id":"heading","label":"Heading","default":"Good work begins with a conversation."},{"type":"richtext","id":"text","label":"Text","default":"<p>For editorial, commercial, advertising or general enquiries, please get in touch. We welcome considered opportunities and useful conversations.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Send enquiry"}]}{% endschema %}