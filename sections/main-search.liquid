<div class="page-width search-page"><p class="eyebrow">Find something</p><h1 class="section-heading">Search</h1><form action="{{ routes.search_url }}" method="get" role="search" class="contact-form"><div class="field field--full"><label for="SearchInput">Search publications and products</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search"></div><button class="button" type="submit">Search ↗</button></form>{% if search.performed %}<h2 class="publication-title" style="margin-top:45px">Results</h2>{% for item in search.results %}<p><a class="text-link" href="{{ item.url }}">{{ item.title | escape }} →</a></p>{% else %}<p>No results found. Try another search.</p>{% endfor %}{% endif %}</div>{% schema %}{"name":"Main search","settings":[]}{% endschema %}