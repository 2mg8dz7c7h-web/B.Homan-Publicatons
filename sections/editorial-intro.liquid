<section class="page-width intro" id="about"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="section-heading">{{ section.settings.heading | escape | newline_to_br }}</h2></div><div class="intro-aside"><div class="lead">{{ section.settings.text }}</div>{% if section.settings.link_label != blank %}<p><a class="text-link" href="{{ section.settings.link_url | default: routes.root_url }}">{{ section.settings.link_label | escape }} →</a></p>{% endif %}</div></section>
{% schema %}{"name":"Editorial introduction","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The publishing house"},{"type":"textarea","id":"heading","label":"Heading","default":"Rooted in place.\nLooking outward."},{"type":"richtext","id":"text","label":"Text","default":"<p>B. Homan Publications is an independent publishing house with a regional point of view and a broad curiosity about the world. We believe good publishing gives people a clearer understanding of the places they live, the work they do and the ideas that move them forward.</p><p>Our ambition is to create considered publications with substance, character and a lasting connection to their readers.</p>"},{"type":"text","id":"link_label","label":"Link label","default":"More about us"},{"type":"url","id":"link_url","label":"Link"}]}{% endschema %}