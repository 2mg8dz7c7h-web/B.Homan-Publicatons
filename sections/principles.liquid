<section class="principles" id="principles"><div class="page-width"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="section-heading">{{ section.settings.heading | escape }}</h2><div class="principle-grid">{% for block in section.blocks %}<article class="principle" {{ block.shopify_attributes }}><span>{{ forloop.index | prepend: '0' }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Our principles","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"What guides us"},{"type":"text","id":"heading","label":"Heading","default":"A clear set of principles."}],"blocks":[{"type":"principle","name":"Principle","settings":[{"type":"text","id":"title","label":"Title","default":"Editorial integrity"},{"type":"textarea","id":"text","label":"Text","default":"Careful research, fair representation and a commitment to accuracy."}]}],"presets":[{"name":"Our principles","blocks":[{"type":"principle","settings":{"title":"Editorial integrity","text":"Careful research, fair representation and a commitment to accuracy."}},{"type":"principle","settings":{"title":"Regional perspective","text":"An enduring interest in the communities, businesses and landscapes beyond the capitals."}},{"type":"principle","settings":{"title":"Enduring quality","text":"Considered design and useful content made with the reader’s time and trust in mind."}}]}]}{% endschema %}