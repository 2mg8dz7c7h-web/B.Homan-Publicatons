<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f7f6f0"><link rel="canonical" href="{{ canonical_url }}">
<title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
{{ content_for_header }}
<style>
:root{--paper:{{ settings.color_background }};--ink:{{ settings.color_text }};--green:{{ settings.color_accent }}}
</style>
{{ 'base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</head>
<body class="template-{{ request.page_type | handle }}">
<a class="skip-link" href="#MainContent">Skip to content</a>
{% section 'header' %}
<main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
{% section 'footer' %}
</body></html>